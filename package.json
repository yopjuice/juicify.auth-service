{
  "name": "auth-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --passWithNoTests --reporter=tree",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.mts --no-file-parallelism --passWithNoTests --reporter=tree",
    "start:cluster": "tsx ./src/app/cluster/multicore.js",
    "start:threads": "tsx ./src/app/threads/producer.js",
    "start:pool": "tsx ./src/app/threads/pool.ts",
    "init-db": "tsx ./src/scripts/init-db.ts",
    "_db:diff:run": "psqldef -U $DATABASE_USER -h $DATABASE_HOST -W $DATABASE_PASSWORD $DATABASE_DB --dry-run < sql/schema.sql",
    "db:diff": "dotenv -- pnpm run _db:diff:run",
    "_db:apply:run": "psqldef -U $DATABASE_USER -h $DATABASE_HOST -W $DATABASE_PASSWORD $DATABASE_DB < sql/schema.sql",
    "db:apply": "dotenv -- pnpm run _db:apply:run",
    "db:types": "pnpm exec dotenv -e .env -- pnpm exec pgtyped -c pgtyped.config.json",
    "test:unit": "node --import tsx --test src/**/*.unit.test.ts",
    "test:integration": "node --import tsx --test src/**/*.integration.test.ts",
    "dry-ci": "act ",
    "dry-cd": "act -P local-ubuntu=-self-hosted"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@juice11-micro/contracts": "^1.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.2.6",
    "@pgtyped/runtime": "^2.4.2",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.0.1",
    "@pgtyped/cli": "^2.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.5",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "pgtyped": "^0.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
